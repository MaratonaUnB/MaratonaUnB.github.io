---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import { siteConfig } from "@/config/site";

const metadata = {
  title: "Contato",
  description: "Entre em contato com a Maratona UnB de Programação.",
};
---

<BaseLayout {metadata}>
  <PageHeader title="Contato" />
  <div class="mx-auto max-w-2xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <p class="text-lg text-muted-foreground">
      Para dúvidas, parcerias ou mais informações sobre a Maratona de
      Programação, envie um e-mail para:
    </p>
    <a
      href={`mailto:${siteConfig.email}`}
      class="mt-6 inline-block text-2xl font-bold text-primary hover:underline"
    >
      {siteConfig.email}
    </a>
  </div>
</BaseLayout>
