---
// Bloco "Último evento / Próximo evento" (home e /eventos). Lado a lado:
// - Último: o mais recente com status "realizado".
// - Próximo: o primeiro com status "confirmado" que ainda não terminou.
// Os dois consideram todos os eventos do calendário (ver lib/eventos.ts).
//
// O GitHub Pages não tem rebuild agendado: se ninguém der push depois que o
// próximo evento acontecer, a página ficaria anunciando um evento passado.
// Por isso o build gera um card para CADA confirmado futuro (todos ocultos
// menos o primeiro) e o script no fim mostra, com o relógio de quem visita,
// o primeiro que ainda não terminou — ou o aviso de "nenhum confirmado".
import CardEventoResumo from "@/components/widgets/CardEventoResumo.astro";
import { fimDoEvento, getEventosOrdenados, getProximosConfirmados, getUltimoEProximo } from "@/lib/eventos";

const eventos = await getEventosOrdenados();
const { ultimo } = getUltimoEProximo(eventos);
const candidatos = getProximosConfirmados(eventos);
---

<section class="reveal border-y border-border bg-card" id="next-event">
  <div class="mx-auto grid max-w-6xl gap-6 px-4 py-12 sm:px-6 md:grid-cols-2 lg:px-8">
    {ultimo && <CardEventoResumo evento={ultimo} rotulo="Último evento" />}

    <div id="proximo-evento">
      {candidatos.map((evento, i) => <CardEventoResumo evento={evento} rotulo="🏆 Próximo evento" mostrarInscricao data-proximo-candidato data-fim={fimDoEvento(evento)} hidden={i !== 0} />)}
      <article id="proximo-evento-vazio" class="flex h-full flex-col justify-center rounded-2xl border border-dashed border-border p-5" hidden={candidatos.length > 0}>
        <p class="text-xs font-semibold uppercase tracking-wide text-primary">🏆 Próximo evento</p>
        <p class="mt-2 text-sm text-muted-foreground">
          Nenhum evento confirmado no momento. Acompanhe o <a href="/eventos" class="link font-semibold">calendário</a>.
        </p>
      </article>
    </div>
  </div>
</section>

<script>
  function atualizarProximoEvento() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-proximo-candidato]"));
    const vazio = document.getElementById("proximo-evento-vazio");
    const agora = Date.now();
    const primeiro = cards.find((card) => Number(card.dataset.fim) > agora);
    cards.forEach((card) => (card.hidden = card !== primeiro));
    if (vazio) vazio.hidden = !!primeiro;
  }

  document.addEventListener("astro:page-load", atualizarProximoEvento);
</script>
