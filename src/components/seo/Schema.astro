---
import { siteConfig } from "@/config/site";

interface Props {
  type: "WebSite" | "BlogPosting" | "BreadcrumbList" | "Event" | "Organization";
  data: {
    title?: string;
    description?: string;
    image?: string;
    pubDate?: Date;
    author?: string;
    url?: string;
    startDate?: Date;
    location?: string;
  };
}

const { type, data } = Astro.props;

let schema = {};

if (type === "WebSite") {
  schema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.name,
    url: siteConfig.url,
    description: siteConfig.description,
    author: {
      "@type": "Person",
      name: siteConfig.author,
    },
    sameAs: [
      siteConfig.socialLinks.instagram,
      siteConfig.socialLinks.youtube,
      siteConfig.socialLinks.github,
    ],
  };
} else if (type === "BlogPosting") {
  schema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    image: data.image,
    datePublished: data.pubDate,
    author: {
      "@type": "Person",
      name: data.author,
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": data.url,
    },
    publisher: {
      "@type": "Organization",
      name: siteConfig.name,
      logo: {
        "@type": "ImageObject",
        // Placeholder, ideally should be a real logo URL
        url: new URL("/favicon.svg", siteConfig.url).toString(),
      },
    },
  };
} else if (type === "Organization") {
  schema = {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    name: siteConfig.name,
    url: siteConfig.url,
    email: siteConfig.email,
    logo: new URL("/favicon.svg", siteConfig.url).toString(),
    parentOrganization: {
      "@type": "CollegeOrUniversity",
      name: "Universidade de Brasília",
      url: "https://unb.br/",
    },
    sameAs: [
      siteConfig.socialLinks.instagram,
      siteConfig.socialLinks.youtube,
      siteConfig.socialLinks.telegram,
      siteConfig.socialLinks.github,
    ],
  };
} else if (type === "Event") {
  schema = {
    "@context": "https://schema.org",
    "@type": "Event",
    name: data.title,
    description: data.description,
    image: data.image,
    startDate: data.startDate,
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    eventStatus: "https://schema.org/EventScheduled",
    location: {
      "@type": "Place",
      name: data.location || "Universidade de Brasília",
      address: "Universidade de Brasília, Brasília, DF",
    },
    organizer: {
      "@type": "Organization",
      name: siteConfig.name,
      url: siteConfig.url,
    },
  };
}
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
