---
// Galeria de posts do Instagram via embed oficial (embed.js), sem precisar
// de token de API — veja src/data/instagramPosts.ts para adicionar posts.
import { instagramPosts } from "@/data/instagramPosts";
import { siteConfig } from "@/config/site";
---

{
  instagramPosts.length > 0 ? (
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {instagramPosts.map((url) => (
        <blockquote
          class="instagram-media"
          data-instgrm-permalink={url}
          data-instgrm-version="14"
          style="margin: 0; width: 100%;"
        />
      ))}
    </div>
  ) : (
    <div class="rounded-2xl border border-dashed border-border p-8 text-center text-sm text-muted-foreground">
      Nenhum post configurado ainda. Siga{" "}
      <a
        href={siteConfig.socialLinks.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="text-primary hover:underline"
      >
        @unballooon no Instagram
      </a>{" "}
      e adicione as URLs dos posts em{" "}
      <code class="rounded bg-muted px-1.5 py-0.5">
        src/data/instagramPosts.ts
      </code>{" "}
      para exibi-los aqui.
    </div>
  )
}

{
  instagramPosts.length > 0 && (
    <>
      <script is:inline async src="//www.instagram.com/embed.js" />
      <script is:inline>
        document.addEventListener("astro:page-load", () => {
          if (window.instgrm) window.instgrm.Embeds.process();
        });
      </script>
    </>
  )
}
