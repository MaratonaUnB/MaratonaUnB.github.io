---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import Hero from "@/components/widgets/Hero.astro";
import NextEvent from "@/components/widgets/NextEvent.astro";
import PostItem from "@/components/blog/PostItem.astro";
import { getCollection } from "astro:content";

const metadata = {
  title: `${siteConfig.shortName} — UnB`,
  description: siteConfig.description,
  ignoreTitleTemplate: true,
};

const allPosts = await getCollection("blog");
const ultimasNoticias = allPosts
  .filter((p) => p.data.category === "noticias")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<BaseLayout {metadata}>
  <Hero
    title="Maratona de Programação"
    description={`Juntos, nos preparamos para "simplesmente, o maior, mais antigo e mais prestigiado concurso de programação do mundo".`}
    actions={[{ text: "Saiba mais", href: "/organizacao", variant: "primary" }]}
  >
    <img
      src="/site/hero-laboratorio.jpg"
      alt="Estudantes competindo em laboratório de informática durante a Maratona UnB de Programação"
      class="mx-auto mt-12 w-full max-w-4xl rounded-3xl border border-border/50 object-cover shadow-2xl"
      loading="eager"
    />
  </Hero>

  <NextEvent />

  <section class="reveal mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-primary">
      Maratona de Programação
    </h2>
    <p class="mt-4 text-lg leading-relaxed text-foreground">
      {siteConfig.description}
      Professores e alunos da UnB organizam disciplinas, palestras, eventos e
      grupos de estudo para prepararem os participantes para competições como
      a Olimpíada Brasileira de Informática e a Maratona SBC de Programação.
    </p>
  </section>

  <section class="reveal mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-8">
    <div class="mb-10 flex items-center justify-between">
      <h2 class="text-2xl font-bold text-foreground sm:text-3xl">
        Últimas Notícias
      </h2>
      <a
        href="/blog/category/noticias"
        class="text-sm font-semibold text-primary hover:underline"
      >
        Ver todas as notícias →
      </a>
    </div>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {ultimasNoticias.map((post) => <PostItem post={post} />)}
    </div>
  </section>

  <section class="reveal mx-auto max-w-3xl px-4 pb-20 text-center sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-border bg-card p-10">
      <h2 class="text-2xl font-bold text-foreground sm:text-3xl">
        Quer patrocinar a Maratona de Programação?
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-muted-foreground">
        Conecte sua marca aos melhores talentos em programação competitiva do
        Distrito Federal.
      </p>
      <a
        href="/patrocinadores"
        class="mt-6 inline-flex items-center rounded-xl bg-foreground px-6 py-3 text-base font-bold text-background transition-all hover:bg-foreground/90"
        onclick="if (typeof gtag === 'function') gtag('event', 'cta_click', { cta: 'quero-patrocinar-home' });"
      >
        Quero patrocinar →
      </a>
    </div>
  </section>
</BaseLayout>
