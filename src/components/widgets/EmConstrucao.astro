---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config/site";

interface Props {
  // Mensagem específica sobre o que ainda falta nesta página.
  mensagem?: string;
}

const { mensagem = "Ainda estamos organizando o conteúdo desta página." } =
  Astro.props;
---

<section class="flex justify-center px-4 py-16 sm:py-24">
  <div class="flex w-full max-w-lg flex-col items-center gap-8 text-center">
    <div
      class="ec-card w-full overflow-hidden rounded-2xl border border-border bg-card text-left shadow-lg"
    >
      <div
        class="flex items-center gap-2 border-b border-border bg-muted px-4 py-3"
      >
        <span class="h-3 w-3 rounded-full bg-red-400/70"></span>
        <span class="h-3 w-3 rounded-full bg-yellow-400/70"></span>
        <span class="h-3 w-3 rounded-full bg-green-400/70"></span>
        <span class="ml-2 font-mono text-xs text-muted-foreground">
          Página
        </span>
      </div>
      <pre
        class="overflow-x-auto p-6 font-mono text-[13px] leading-relaxed sm:text-sm"><code><span class="text-muted-foreground">// TODO(maratona): terminar esta página</span>
<span class="text-primary">function</span> <span class="ec-fn text-[var(--accent)]">renderizarPagina</span>() {"{"}
  <span class="text-primary">return</span> "<span class="ec-typed" /><span class="ec-cursor">▍</span>"
{"}"}</code></pre>
    </div>

    <div>
      <h2 class="text-2xl font-bold text-foreground">Página em construção</h2>
      <p class="mt-3 text-muted-foreground">
        {mensagem} Volte em breve para conferir.
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-3">
      <a
        href="/eventos"
        class="inline-flex items-center gap-2 rounded-xl bg-foreground px-6 py-3 text-base font-bold text-background transition-all hover:bg-foreground/90"
      >
        Ver calendário de eventos
      </a>
      <a
        href={`mailto:${siteConfig.email}`}
        class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-6 py-3 text-base font-bold text-foreground transition-all hover:border-primary hover:text-primary"
      >
        <Icon name="lucide:mail" class="-ml-1 h-4 w-4" />
        Quero contribuir
      </a>
    </div>
  </div>
</section>

<style>
  .ec-cursor {
    animation: ec-blink 1s step-end infinite;
  }
  @keyframes ec-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  const FRASES = [
    "em breve...",
    "coletando os resultados...",
    "aguardando o próximo commit...",
    "quase lá...",
  ];

  function tick(
    typedEl: HTMLElement,
    frase: string,
    i: number,
    apagando: boolean,
  ) {
    typedEl.textContent = frase.slice(0, i);

    let delay = apagando ? 35 : 65;
    let proximoI = apagando ? i - 1 : i + 1;
    let proximoApagando = apagando;

    if (!apagando && i === frase.length) {
      delay = 1400;
      proximoApagando = true;
      proximoI = frase.length;
    } else if (apagando && i === 0) {
      delay = 300;
      proximoApagando = false;
      proximoI = 0;
      frase = FRASES[(FRASES.indexOf(frase) + 1) % FRASES.length];
    }

    setTimeout(() => tick(typedEl, frase, proximoI, proximoApagando), delay);
  }

  function setupTypewriters() {
    document.querySelectorAll<HTMLElement>(".ec-typed").forEach((el) => {
      if (el.dataset.ecStarted) return;
      el.dataset.ecStarted = "true";
      tick(el, FRASES[0], 0, false);
    });
  }

  document.addEventListener("astro:page-load", setupTypewriters);
</script>
