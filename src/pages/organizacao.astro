---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";

const metadata = {
  title: "Organização",
  description:
    "O projeto de extensão Maratona de Programação no Distrito Federal visa capacitar alunos do Ensino Médio e Superior em programação competitiva.",
};

const professoresUnb = [
  "Daniel Porto",
  "Guilherme Ramos",
  "Vinicius Borges",
  "Edson Alves",
  "Bruno Ribas",
];

const maratonaDf = [
  { nome: "Daniel Saad", instituicao: "IFB" },
  { nome: "Patrícia Moscariello", instituicao: "IESB" },
  { nome: "Jeremias Gomes", instituicao: "IDP" },
  { nome: "Lucas Matiolli", instituicao: null },
];
---

<BaseLayout {metadata}>
  <PageHeader title="Organização" />
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <p class="text-lg leading-relaxed text-foreground">
      O projeto de extensão <strong>Maratona de Programação no Distrito Federal</strong>
      visa capacitar alunos do Ensino Médio interessados em computação e alunos
      do Ensino Superior, por meio do ensino de programação de computadores em
      uma abordagem baseada em programação competitiva.
    </p>
    <p class="mt-6 text-lg leading-relaxed text-foreground">
      O time de professores e alunos da Universidade de Brasília (UnB) organiza
      grupos de estudo em programação competitiva para o público-alvo, nos
      níveis intermediário e avançado, com o objetivo de aprimorar suas
      habilidades em programação, bem como na preparação para competições de
      programação, como a <strong>Olimpíada Brasileira de Informática</strong> e
      a <strong>Maratona SBC de Programação</strong>.
    </p>

    <h2 class="mt-14 text-2xl font-bold text-foreground">Professores da UnB</h2>
    <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
      {
        professoresUnb.map((nome) => (
          <li class="rounded-xl border border-border bg-card px-4 py-3 text-sm font-medium text-foreground">
            {nome}
          </li>
        ))
      }
    </ul>

    <div class="mt-14 flex items-center gap-4">
      <img
        src="/site/logo-maratona-df.jpeg"
        alt="Logo do Grupo Maratona DF"
        class="h-16 w-16 shrink-0 rounded-xl object-contain"
      />
      <h2 class="text-2xl font-bold text-foreground">Grupo Maratona DF</h2>
    </div>
    <p class="mt-2 text-muted-foreground">
      Além do time da UnB, contamos com o apoio de professores de outras
      instituições do Distrito Federal — o <strong>Grupo Maratona DF</strong> —
      que colaboram na organização e na preparação dos estudantes para as
      competições.
    </p>
    <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
      {
        maratonaDf.map((pessoa) => (
          <li class="rounded-xl border border-border bg-card px-4 py-3 text-sm font-medium text-foreground">
            {pessoa.nome}
            {pessoa.instituicao && (
              <span class="text-muted-foreground"> — {pessoa.instituicao}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
