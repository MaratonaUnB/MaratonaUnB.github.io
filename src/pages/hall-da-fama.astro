---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import ResumoHallDaFama from "@/components/widgets/ResumoHallDaFama.astro";
import { hallDaFamaIcpc } from "@/data/hallDaFamaIcpc";
import { CONQUISTAS, NIVEIS, imagemDaConquista, pontos, totalDoAluno } from "@/data/pontuacaoIcpc";

const metadata = {
  title: "Hall da Fama — ICPC",
  description: "Ranking dos alunos da UnB no ICPC: Final Mundial, LatAm e Final Brasileira.",
};

// Ranking: maior total primeiro; empate no total divide a posição (1, 1, 3).
const ranking = hallDaFamaIcpc
  .map((aluno) => ({ aluno, total: totalDoAluno(aluno) }))
  .sort((a, b) => b.total - a.total || a.aluno.nome.localeCompare(b.aluno.nome, "pt-BR"))
  .map((linha, i, lista) => ({ ...linha, posicao: i > 0 && lista[i - 1].total === linha.total ? -1 : i + 1 }));
let ultimaPosicao = 1;
for (const linha of ranking) linha.posicao = linha.posicao === -1 ? ultimaPosicao : (ultimaPosicao = linha.posicao);

// Só entram colunas que valem pontos naquele nível E em que algum aluno tem
// pelo menos uma conquista — assim a tabela não se enche de colunas vazias.
const grupos = NIVEIS.map((nivel) => ({
  ...nivel,
  colunas: CONQUISTAS.filter((c) => pontos[nivel.id][c.id] !== undefined && hallDaFamaIcpc.some((a) => (a[nivel.id]?.[c.id] ?? 0) > 0)),
})).filter((g) => g.colunas.length > 0);
---

<BaseLayout {metadata}>
  <PageHeader title="Hall da Fama" subtitle="ICPC" icon="lucide:star" logo="/site/marcas/icpc.png" logoAlt="Logo do ICPC" />
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <p class="text-muted-foreground">
      Reconhecimento aos alunos com participações nas fases <strong>Mundial (World Finals)</strong>, <strong>LatAm</strong> e <strong>Final Brasileira</strong> do ICPC.
    </p>
    <ResumoHallDaFama />

    <h2 class="mt-12 text-xl font-bold text-foreground">Ranking dos alunos</h2>
    <div class="mt-4 overflow-x-auto rounded-2xl border border-border">
      <table class="w-full text-sm">
        <thead class="bg-muted text-xs uppercase tracking-wider text-muted-foreground">
          <tr>
            <th rowspan="2" class="px-3 py-2 text-right">#</th>
            <th rowspan="2" class="px-3 py-2 text-left">Nome</th>
            <th rowspan="2" class="border-l border-border px-3 py-2 text-right">Pontos</th>
            {
              grupos.map((g) => (
                <th colspan={g.colunas.length} class="border-l border-border px-2 pt-2 pb-1 text-center">
                  <span class="inline-flex items-center gap-1.5">
                    <img src={`/fama/logo-${g.sufixo}.png`} alt="" class="h-5 w-5 object-contain" />
                    {g.nome}
                  </span>
                </th>
              ))
            }
          </tr>
          <tr>
            {
              grupos.map((g) =>
                g.colunas.map((c, i) => (
                  <th class:list={["px-1 pb-2 text-center", { "border-l border-border": i === 0 }]} title={`${c.rotulo} — ${pontos[g.id][c.id]} pontos`}>
                    <img src={imagemDaConquista(c, g.sufixo)} alt={c.rotulo} class="mx-auto h-6 w-6 object-contain" />
                  </th>
                )),
              )
            }
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {
            ranking.map(({ aluno, total, posicao }) => (
              <tr class="hover:bg-muted/50">
                <td class="px-3 py-2.5 text-right tabular-nums text-muted-foreground">{posicao}</td>
                <td class="px-3 py-2.5 font-semibold text-foreground">{aluno.nome}</td>
                <td class="border-l border-border px-3 py-2.5 text-right font-bold tabular-nums text-primary">{total}</td>
                {grupos.map((g) =>
                  g.colunas.map((c, i) => {
                    const qtd = aluno[g.id]?.[c.id] ?? 0;
                    return <td class:list={["px-1 py-2.5 text-center tabular-nums text-muted-foreground", { "border-l border-border": i === 0 }]}>{qtd > 0 ? qtd : ""}</td>;
                  }),
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <details class="mt-4 text-sm text-muted-foreground">
      <summary class="cursor-pointer font-semibold text-foreground">Como a pontuação é calculada</summary>
      <p class="mt-2">Cada conquista vale pontos conforme o nível da competição. O total é a soma de todas as conquistas do aluno.</p>
      <div class="mt-3 overflow-x-auto">
        <table class="text-xs">
          <thead>
            <tr>
              <th class="px-2 py-1 text-left">Conquista</th>
              {NIVEIS.map((n) => <th class="px-2 py-1 text-right">{n.nome}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              CONQUISTAS.map((c) => (
                <tr>
                  <td class="px-2 py-1">
                    <span class="inline-flex items-center gap-2">
                      <img src={imagemDaConquista(c, "Brasil")} alt="" class="h-4 w-4 object-contain" />
                      {c.rotulo}
                    </span>
                  </td>
                  {NIVEIS.map((n) => (
                    <td class="px-2 py-1 text-right tabular-nums">{pontos[n.id][c.id] ?? "—"}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>
  </div>
</BaseLayout>
