---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import { depoimentos } from "@/data/depoimentos";

const metadata = {
  title: "Depoimentos",
  description: "O que dizem os ex-competidores da Maratona UnB de Programação.",
};
---

<BaseLayout {metadata}>
  <PageHeader title="Depoimentos" subtitle="A voz de quem já competiu." />
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    {
      depoimentos.length > 0 ? (
        <div class="flex flex-col gap-6">
          {depoimentos.map((d) => (
            <blockquote class="w-full rounded-2xl border border-border bg-card p-6">
              <p class="text-foreground">“{d.texto}”</p>
              <footer class="mt-4 flex items-center gap-3">
                {d.foto && (
                  <img
                    src={d.foto}
                    alt={d.nome}
                    class="h-10 w-10 rounded-full object-cover"
                  />
                )}
                <div>
                  <p class="text-sm font-semibold text-foreground">
                    <a href={d.url} target="_blank" rel="noopener noreferrer">
                      {d.nome}
                    </a>
                  </p>
                  <p class="text-xs text-muted-foreground">{d.papel}</p>
                </div>
              </footer>
            </blockquote>
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-border p-10 text-center">
          <p class="text-muted-foreground">
            Se você competiu e quer compartilhar sua experiência, entre em{" "}
            <a
              href="mailto:maratona@unb.br"
              aria-label="Enviar e-mail para maratona@unb.br"
              class="rounded-full p-2 text-foreground transition-colors hover:bg-muted hover:text-primary"
            >
              contato conosco
            </a>
            .
          </p>
        </div>
      )
    }
    <p class="pt-10 pl-5 mt-2 text-xs text-muted-foreground">
      Publicamos apenas depoimentos reais, com autorização de quem os deu.
    </p>
  </div>
</BaseLayout>
