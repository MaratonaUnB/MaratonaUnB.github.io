---
import { siteConfig } from "@/config/site";
import { Icon } from "astro-icon/components";
---

<footer class="mt-20 border-t border-border bg-card">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-6 md:flex-row md:items-start">
      <div class="flex flex-col items-center gap-3 md:items-start">
        <span class="text-sm font-medium text-muted-foreground">Apoio:</span>
        <div class="flex items-center gap-4">
          {
            siteConfig.supporters.map((supporter) => (
              <a
                href={supporter.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={supporter.name}
                class="text-sm font-semibold text-foreground transition-colors hover:text-primary"
              >
                {supporter.logo ? (
                  <img
                    src={supporter.logo}
                    alt={supporter.name}
                    class="h-7 w-auto object-contain"
                  />
                ) : (
                  supporter.name
                )}
              </a>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col items-center gap-3 md:items-end">
        <div class="flex items-center gap-1">
          {
            siteConfig.headerSocialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.text}
                class="rounded-full p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-primary"
              >
                <Icon name={social.icon} class="h-5 w-5" />
              </a>
            ))
          }
          <a
            href={`mailto:${siteConfig.email}`}
            aria-label={`Enviar e-mail para ${siteConfig.email}`}
            class="rounded-full p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-primary"
          >
            <Icon name="lucide:mail" class="h-5 w-5" />
          </a>
        </div>
        <button
          id="back-to-top"
          type="button"
          aria-label="Voltar ao topo"
          class="rounded-full border border-border bg-background px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-primary hover:text-primary"
        >
          Voltar ao topo ↑
        </button>
      </div>
    </div>

    <div
      class="mt-8 border-t border-border pt-6 text-center text-xs text-muted-foreground"
    >
      Copyright &copy; {new Date().getFullYear()} -
      <a href="https://unb.br/" target="_blank" rel="noopener noreferrer" class="hover:text-primary">
        Universidade de Brasília
      </a>. Todos os direitos reservados.
    </div>
  </div>
</footer>

<script>
  document.addEventListener("astro:page-load", () => {
    document.getElementById("back-to-top")?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });
</script>
