---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Schema from "@/components/seo/Schema.astro";
import Button from "@/components/ui/Button.astro";
import TagsEvento from "@/components/ui/TagsEvento.astro";
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";
import { getEventosOrdenados, getProximoEvento, slugDoEvento } from "@/lib/eventos";
import { siteConfig } from "@/config/site";

export async function getStaticPaths() {
  const eventos = await getCollection("eventos");
  return eventos
    .filter((evento) => evento.data.temPagina)
    .map((evento) => ({
      params: { slug: slugDoEvento(evento) },
      props: { evento },
    }));
}

const { evento } = Astro.props;
const { Content } = await render(evento);
const { title, date, local, horario, mapaUrl, cover, coverAlt, inscricoesUrl, resultadosUrl, status, tag } = evento.data;

// Depois do evento, inscrições e dúvidas perdem o sentido — a página passa
// a apontar para os resultados. O gatilho é o status, não a data, para que
// a troca seja uma decisão editorial explícita.
const realizado = status === "realizado";

const eventosOrdenados = await getEventosOrdenados();
// getProximoEvento cai de volta no último evento realizado quando não há
// nenhum futuro — por isso o selo exige isFuturo, não só o id batendo.
const { evento: proximo, isFuturo } = getProximoEvento(eventosOrdenados);
const isProximo = isFuturo && !realizado && proximo?.id === evento.id;

const formattedDate = date.toLocaleDateString("pt-BR", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const metadata = {
  title,
  description: `${title} — ${formattedDate}${local ? `, ${local}` : ""}.`,
  ogImage: cover,
};
---

<BaseLayout metadata={metadata}>
  <Schema
    type="Event"
    data={{
      title,
      description: metadata.description,
      image: cover,
      startDate: date,
      location: local,
      url: Astro.url.href,
    }}
  />
  <section class="relative px-4 py-8 sm:px-6 lg:px-8 md:py-12">
    <div class="relative mx-auto max-w-3xl">
      <div class="reveal mb-8 text-center">
        {
          isProximo && (
            <span id="selo-proximo-evento" data-date={date.toISOString()} class="mb-3 inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary">
              🏆 Próximo evento
            </span>
          )
        }
        <h1 class="font-heading mt-2 text-3xl font-bold leading-tight tracking-tight text-foreground sm:text-4xl md:text-5xl">
          {title}
        </h1>
        <TagsEvento tags={tag} class="mt-4 justify-center" />
      </div>

      {
        cover && (
          <div class="reveal relative mb-8 flex max-h-[24rem] w-full items-center justify-center overflow-hidden rounded-2xl bg-white shadow-lg">
            <img src={cover} alt={coverAlt || title} class="max-h-[24rem] w-full object-contain" />
          </div>
        )
      }

      <div class="reveal flex flex-col gap-4 rounded-2xl border border-border bg-card p-6">
        <div class="flex items-center gap-3">
          <Icon name="lucide:calendar" class="h-5 w-5 shrink-0 text-primary" />
          <div class="text-sm font-medium text-foreground">
            {formattedDate}
          </div>
        </div>

        {
          horario && (
            <div class="flex items-center gap-3">
              <Icon name="lucide:clock" class="h-5 w-5 shrink-0 text-primary" />
              <div class="text-sm font-medium text-foreground">{horario}</div>
            </div>
          )
        }

        {
          local && (
            <div class="flex items-center gap-3">
              <Icon name="lucide:map-pin" class="h-5 w-5 shrink-0 text-primary" />
              <div class="text-sm font-medium text-foreground">{local}</div>
            </div>
          )
        }

        {
          mapaUrl && (
            <a href={mapaUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3">
              <Icon name="lucide:map" class="h-5 w-5 shrink-0 text-primary" />
              <div class="text-sm font-semibold text-primary">Ver no mapa →</div>
            </a>
          )
        }
      </div>

      <div
        class="reveal prose prose-lg mx-auto mt-8 prose-headings:text-foreground prose-a:text-primary prose-a:underline prose-a:decoration-primary/35 hover:prose-a:decoration-current prose-p:text-muted-foreground prose-strong:text-foreground prose-li:text-muted-foreground"
      >
        <Content />
      </div>

      {
        realizado && resultadosUrl && (
          <div class="reveal mt-10 rounded-2xl border-2 border-accent bg-card p-6 text-center">
            <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-accent/10 text-accent">
              <Icon name="lucide:trophy" class="h-6 w-6" />
            </span>
            <h2 class="text-lg font-bold text-foreground">Resultados</h2>
            <p class="mt-2 text-sm text-muted-foreground">Confira o placar final e o relatório da competição.</p>
            <div class="mt-4">
              <Button href={resultadosUrl} variant="primary" target="_blank" rel="noopener noreferrer">
                <Icon name="lucide:trophy" class="-ml-1 mr-2 h-5 w-5" />
                Ver resultados
              </Button>
            </div>
          </div>
        )
      }

      {
        !realizado && inscricoesUrl && (
          <div class="reveal mt-10 rounded-2xl border border-border bg-card p-6 text-center">
            <h2 class="text-lg font-bold text-foreground">Inscrições</h2>
            <p class="mt-2 text-sm text-muted-foreground">Garanta a vaga do seu time — inscrições abertas.</p>
            <div class="mt-4">
              <Button href={inscricoesUrl} variant="primary">
                <Icon name="lucide:pencil-line" class="-ml-1 mr-2 h-5 w-5" />
                Inscreva-se
              </Button>
            </div>
          </div>
        )
      }

      {
        !realizado && (
          <div class="reveal mt-10 rounded-2xl border border-border bg-card p-6 text-center">
            <h2 class="text-lg font-bold text-foreground">Dúvidas</h2>
            <p class="mt-2 text-sm text-muted-foreground">
              Qualquer pergunta sobre o evento, fale com a gente:
              <a href={`mailto:${siteConfig.email}`} class="link font-semibold">
                {siteConfig.email}
              </a>
            </p>
          </div>
        )
      }

      <div class="reveal mt-10 text-center">
        <a href="/eventos" class="link font-semibold"> ← Ver todos os eventos </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // O selo é calculado no build, e o GitHub Pages não tem rebuild agendado:
  // se ninguém der push depois do evento, a página continuaria anunciando
  // "Próximo evento". Mesmo critério do getProximoEvento (data >= agora),
  // mas com o relógio de quem está vendo a página.
  document.addEventListener("astro:page-load", () => {
    const selo = document.getElementById("selo-proximo-evento");
    if (selo?.dataset.date && new Date(selo.dataset.date).valueOf() < Date.now()) selo.hidden = true;
  });
</script>
