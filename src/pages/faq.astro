---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import { siteConfig } from "@/config/site";

const metadata = {
  title: "Perguntas frequentes",
  description: "Dúvidas comuns sobre inscrição, elegibilidade e formato das competições da Maratona UnB.",
};

const faqs = [
  {
    pergunta: "Quem pode participar da Maratona UnB de Programação?",
    resposta:
      "Estudantes de graduação de qualquer instituição, organizados em times de até três pessoas. Não é necessário ser da área de Computação — qualquer estudante interessado em resolver problemas de programação pode se inscrever.",
  },
  {
    pergunta: "E o Ensino Médio, pode participar de alguma competição?",
    resposta:
      "Sim, pela OBI (Olimpíada Brasileira de Informática), voltada a estudantes do ensino fundamental, médio e início do ensino superior. Veja os detalhes na página da OBI.",
  },
  {
    pergunta: "Preciso pagar para me inscrever?",
    resposta:
      "Não. As inscrições na Maratona UnB de Programação e na OBI são gratuitas.",
  },
  {
    pergunta: "Qual o formato da prova?",
    resposta:
      "Times de três pessoas resolvem, em conjunto, uma lista de problemas de programação em até cinco horas, usando um único computador por time. Vence quem resolver mais problemas, com menor tempo em caso de empate.",
  },
  {
    pergunta: "Existe um limite de participações no ICPC?",
    resposta:
      "Sim. Cada competidor pode participar de até 5 fases regionais (incluindo a 1ª Fase) ou até 2 finais mundiais, além de uma regra que combina o ano de início da graduação com o ano de nascimento. Veja os detalhes completos na página do ICPC.",
  },
  {
    pergunta: "Não sei programar o suficiente. Posso participar mesmo assim?",
    resposta:
      "Sim! O projeto oferece grupos de estudo e cursos preparatórios em níveis intermediário e avançado, abertos para quem quer aprender e evoluir, não só para quem já compete.",
  },
  {
    pergunta: "Como faço parte da comunidade entre uma edição e outra?",
    resposta:
      "Entrando no UnBalloon, o grupo de programação competitiva da UnB — é lá que saem os convites para grupos de estudo, formação de times e novidades sobre competições.",
  },
];
---

<BaseLayout {metadata}>
  <PageHeader title="Perguntas frequentes" />
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="divide-y divide-border rounded-2xl border border-border bg-card">
      {
        faqs.map((item) => (
          <details class="group p-6">
            <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-foreground">
              {item.pergunta}
              <span class="ml-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="mt-3 text-muted-foreground">{item.resposta}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-8 text-center text-muted-foreground">
      Ainda com dúvidas?
      <a href={`mailto:${siteConfig.email}`} class="text-primary hover:underline">
        Fale com a gente
      </a>.
    </p>
  </div>
</BaseLayout>
