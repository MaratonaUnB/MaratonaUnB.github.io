---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  subtitle?: string;
  icon?: string;
  logo?: string;
  logoAlt?: string;
}

const { title, subtitle, icon, logo, logoAlt } = Astro.props;
---

<div class="border-b border-border bg-card">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-6 px-4 py-12 sm:px-6 lg:px-8"
  >
    <div>
      <h1
        class="flex items-center gap-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
      >
        {
          icon && (
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary sm:h-12 sm:w-12">
              <Icon name={icon} class="h-6 w-6 sm:h-7 sm:w-7" />
            </span>
          )
        }
        {title}
      </h1>
      {subtitle && <p class="mt-3 text-lg text-muted-foreground">{subtitle}</p>}
    </div>
    {
      logo && (
        <img
          src={logo}
          alt={logoAlt || ""}
          class="h-16 w-auto shrink-0 object-contain sm:h-20"
        />
      )
    }
  </div>
</div>
