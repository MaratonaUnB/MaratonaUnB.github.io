---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import { calendarioEventos } from "@/data/calendarioEventos";

const metadata = {
  title: "Calendário de Eventos",
  description:
    "Calendário consolidado dos principais eventos de programação competitiva ligados à UnB.",
};

const statusLabel: Record<string, string> = {
  realizado: "✅ Realizado",
  confirmado: "🔵 Confirmado",
  "a-confirmar": "⚪ A confirmar",
};
---

<BaseLayout {metadata}>
  <PageHeader title="Calendário de Eventos" />
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <p class="text-muted-foreground">
      Calendário consolidado dos principais eventos de programação
      competitiva ligados à UnB: fases da Maratona SBC/ICPC, OBI, competições
      internas (Maratona UnB, UnBalloon) e parceiras.
    </p>
    <p class="mt-2 text-sm text-muted-foreground">
      Legenda: ✅ Realizado · 🔵 Confirmado (ainda não realizado) · ⚪ A
      confirmar.
    </p>

    <div class="mt-6 overflow-x-auto rounded-2xl border border-border">
      <table class="w-full text-left text-sm">
        <thead class="bg-muted text-xs uppercase tracking-wider text-muted-foreground">
          <tr>
            <th class="px-4 py-3">Data</th>
            <th class="px-4 py-3">Evento</th>
            <th class="px-4 py-3">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {
            calendarioEventos.map((row) => (
              <tr class="hover:bg-muted/50">
                <td class="px-4 py-3 whitespace-nowrap font-medium text-foreground">
                  {row.data}
                </td>
                <td class="px-4 py-3 text-foreground">{row.evento}</td>
                <td class="px-4 py-3 whitespace-nowrap text-muted-foreground">
                  {statusLabel[row.status]}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-6 text-xs text-muted-foreground">
      Fontes: Maratona SBC de Programação (maratona.sbc.org.br/hist), dados
      processados por gnramos.github.io/maratona-site, e registros internos da
      organização. Para atualizar, edite
      <code class="rounded bg-muted px-1.5 py-0.5">src/data/calendarioEventos.ts</code>
      no repositório do site.
    </p>
  </div>
</BaseLayout>
