---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import NextEvent from "@/components/widgets/NextEvent.astro";
import { calendarioEventos } from "@/data/calendarioEventos";
import { agruparCalendarioPorAno, formatarDataEvento } from "@/lib/calendario";

const metadata = {
  title: "Eventos",
  description:
    "Calendário consolidado dos eventos de programação competitiva ligados à UnB, com o próximo evento sempre em destaque.",
};

const grupos = agruparCalendarioPorAno(calendarioEventos);

const statusLabel: Record<string, string> = {
  realizado: "✅ Realizado",
  confirmado: "🔵 Confirmado",
  "a-confirmar": "⚪ A confirmar",
  adiado: "🟠 Adiado",
};
---

<BaseLayout {metadata}>
  <PageHeader title="Eventos" subtitle="Calendário consolidado da Maratona e competições ligadas à UnB" />
  <NextEvent />

  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="text-muted-foreground">
      Calendário consolidado dos principais eventos de programação
      competitiva ligados à UnB: fases da Maratona SBC/ICPC, OBI, competições
      internas (Maratona UnB, UnBalloon) e parceiras.
    </p>
    <p class="mt-2 text-sm text-muted-foreground">
      Legenda: ✅ Realizado · 🔵 Confirmado (ainda não realizado) · ⚪ A
      confirmar · 🟠 Adiado.
    </p>

    {
      grupos.map((grupo) => (
        <div class="mt-12">
          <h2 class="mb-4 text-2xl font-bold text-foreground">{grupo.ano}</h2>
          <div class="overflow-x-auto rounded-2xl border border-border">
            <table class="w-full text-left text-sm">
              <thead class="bg-muted text-xs uppercase tracking-wider text-muted-foreground">
                <tr>
                  <th class="px-4 py-3">Data</th>
                  <th class="px-4 py-3">Evento</th>
                  <th class="px-4 py-3">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {[...grupo.naoRealizados, ...grupo.realizados].map((row) => (
                  <tr class:list={["hover:bg-muted/50", { "opacity-60": row.status === "realizado" }]}>
                    <td class="px-4 py-3 whitespace-nowrap font-medium text-foreground">
                      {formatarDataEvento(row)}
                    </td>
                    <td class="px-4 py-3 text-foreground">{row.evento}</td>
                    <td class="px-4 py-3 whitespace-nowrap text-muted-foreground">
                      {statusLabel[row.status]}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))
    }

    <p class="mt-8 text-xs text-muted-foreground">
      Fontes: Maratona SBC de Programação (maratona.sbc.org.br/hist), dados
      processados por gnramos.github.io/maratona-site, e registros internos da
      organização (última atualização dos dados originais: 28/08/2026). Para
      atualizar, edite
      <code class="rounded bg-muted px-1.5 py-0.5">src/data/calendarioEventos.ts</code>
      no repositório do site.
    </p>
  </div>
</BaseLayout>
