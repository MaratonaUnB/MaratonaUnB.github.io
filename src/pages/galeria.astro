---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import EmConstrucao from "@/components/widgets/EmConstrucao.astro";

const metadata = {
  title: "Resultados",
  description:
    "Resultados de cada edição da Maratona UnB de Programação e das competições ligadas à UnB.",
};
---

<BaseLayout {metadata}>
  <PageHeader title="Resultados" icon="lucide:image" />
  <EmConstrucao
    mensagem="Em breve, os resultados de cada edição da Maratona e das competições ligadas à UnB aparecerão por aqui."
  />
</BaseLayout>
