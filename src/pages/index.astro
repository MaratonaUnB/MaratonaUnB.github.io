---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import Hero from "@/components/widgets/Hero.astro";
import PostItem from "@/components/blog/PostItem.astro";
import { getCollection } from "astro:content";

const metadata = {
  title: `${siteConfig.shortName} — UnB`,
  description: siteConfig.description,
  ignoreTitleTemplate: true,
};

const allPosts = await getCollection("blog");
const proximoEvento = allPosts
  .filter((p) => p.data.category === "evento-atual")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

const ultimasNoticias = allPosts
  .filter((p) => p.data.category === "noticias")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<BaseLayout {metadata}>
  <Hero
    title="Maratona de Programação"
    description={`Juntos, nos preparamos para "simplesmente, o maior, mais antigo e mais prestigiado concurso de programação do mundo".`}
    actions={[
      {
        text: "Saiba mais",
        href: "/organizacao",
        variant: "primary",
      },
    ]}
  />

  {
    proximoEvento && (
      <section class="reveal border-y border-border bg-card">
        <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
          <p class="text-sm font-semibold uppercase tracking-wide text-primary">
            🏆 Próximo Evento
          </p>
          <h2 class="mt-2 text-2xl font-bold text-foreground sm:text-3xl">
            {proximoEvento.data.title}
          </h2>
          <p class="mt-3 max-w-2xl text-muted-foreground">
            {proximoEvento.data.description}
          </p>
          <p class="mt-2 text-sm text-muted-foreground">
            {proximoEvento.data.author} ·{" "}
            {proximoEvento.data.pubDate.toLocaleDateString("pt-BR", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })}
          </p>
          <a
            href={`/blog/${proximoEvento.id}`}
            class="mt-4 inline-block font-semibold text-primary hover:underline"
          >
            Leia mais →
          </a>
        </div>
      </section>
    )
  }

  <section class="reveal mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-primary">
      Maratona de Programação
    </h2>
    <p class="mt-4 text-lg leading-relaxed text-foreground">
      {siteConfig.description}
      Professores e alunos da UnB organizam disciplinas, palestras, eventos e
      grupos de estudo para prepararem os participantes para competições como
      a Olimpíada Brasileira de Informática e a Maratona SBC de Programação.
    </p>
  </section>

  <section class="reveal mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-8">
    <div class="mb-10 flex items-center justify-between">
      <h2 class="text-2xl font-bold text-foreground sm:text-3xl">
        Últimas Notícias
      </h2>
      <a
        href="/blog/category/noticias"
        class="text-sm font-semibold text-primary hover:underline"
      >
        Ver todas as notícias →
      </a>
    </div>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {ultimasNoticias.map((post) => <PostItem post={post} />)}
    </div>
  </section>
</BaseLayout>
