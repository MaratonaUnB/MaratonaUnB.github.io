---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/widgets/Hero.astro";

const metadata = {
  title: "404 - Página não encontrada",
  description: "A página que você procura não existe.",
  ignoreTitleTemplate: true,
};
---

<BaseLayout {metadata}>
  <Hero
    title={`<h1 class="bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent text-[12rem] font-extrabold tracking-tighter mb-4">404</h1>`}
    description="Não conseguimos encontrar a página que você procura. Ela pode ter sido movida ou removida."
    actions={[
      {
        variant: "primary",
        text: "Voltar para a Home",
        href: "/",
        icon: "lucide:home",
      },
      {
        variant: "secondary",
        text: "Contato",
        href: "/contact",
        icon: "lucide:mail",
      },
    ]}
  />
</BaseLayout>
